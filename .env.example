NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_SECRET_KEY=replace-with-local-secret-key
DEEPSEEK_API_KEY=replace-with-deepseek-api-key
AI_TEXT_PROVIDER=deepseek
AI_TEXT_MODEL=deepseek-flash
# Which resume-to-JD difference prompt runs: p1, p2 or p3. It is part of the
# prompt version, and so of input_hash — changing it re-runs every analysis.
RESUME_JD_DIFFERENCE_PROMPT_VARIANT=p1
# DeepSeek-V4.1-Flash, read from https://api-docs.deepseek.com/quick_start/pricing
# on 2026-09-10. Peak is 01:00-04:00 and 06:00-10:00 UTC.
#
# `model` here MUST equal AI_TEXT_MODEL above. When they differ the services
# drop the schedule and record the run's cost as null. The run does not fail
# and the interface shows nothing; the only signal is an
# `ai-price-schedule-model-mismatch` error in the server log.
#
# The schema has no weekday concept, so the provider's Monday-to-Friday peak is
# priced as if it ran every day. That over-states weekend cost and never
# under-states it. Re-read the page and bump `version` when prices change.
AI_PRICE_SCHEDULE_JSON={"version":"deepseek-flash-usd-2026-09-10","provider":"deepseek","model":"deepseek-flash","currency":"USD","observedAt":"2026-09-10T00:00:00.000Z","sourceUrl":"https://api-docs.deepseek.com/quick_start/pricing","effectiveFrom":"2026-09-10T00:00:00.000Z","effectiveUntil":null,"defaultRates":{"inputCacheHitPerMillion":0.003,"inputCacheMissPerMillion":0.15,"outputPerMillion":0.6},"peak":{"windowsUtc":[{"start":"01:00","end":"04:00"},{"start":"06:00","end":"10:00"}],"rates":{"inputCacheHitPerMillion":0.006,"inputCacheMissPerMillion":0.3,"outputPerMillion":1.2}}}
E2E_FAKE_EXTRACTOR=0
