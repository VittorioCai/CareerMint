{
  "name": "job-search-assistant",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "node scripts/sync-ocr-assets.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --grep-invert @real-ocr",
    "test:e2e:real-ocr": "playwright test --grep @real-ocr",
    "test:db": "supabase test db supabase/tests/database --local",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "eval:jd-gap": "tsx scripts/evaluate-jd-gap-prompts.ts",
    "eval:resume-jd-difference": "tsx scripts/evaluate-resume-jd-difference-prompts.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@napi-rs/canvas": "1.0.5",
    "@paddleocr/paddleocr-js": "^0.4.2",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "file-type": "^22.0.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.1",
    "next": "16.3.0",
    "onnxruntime-web": "1.27.0",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@next/env": "16.3.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "docx": "^9.7.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^30.0.1",
    "pdf-lib": "^1.17.1",
    "supabase": "^2.114.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "tsx": "^4.20.5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.19.0"
}
